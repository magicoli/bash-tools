#    http://www.gnu.org/licenses/agpl-3.0.html

# Make sure we are sourced
[ -n "${BASH_SOURCE[0]:-}" ] && [ "${BASH_SOURCE[0]}" = "$0" ] && {
	echo "$(basename "$0") is meant to be sourced, not run" >&2
	exit 1
}

# Make sure we were not launched twice
[ -n "${BASH_HELPERS:-}" ] && return

BASH_HELPERS=${BASH_SOURCE}
BASH_TOOLS_DIR=$(cd $(dirname "$BASH_HELPERS")/.. && pwd)

# === Generic tools ===
source $BASH_TOOLS_DIR/src/lib/path-helpers || return $?

PID=$$
PGM=${PGM:-$(basename "$0")}
TMP=${TMP:-$(mktemp -t $PGM 2>/dev/null || mktemp -t $PGM.XXXXX 2>/dev/null || echo /tmp/$PGM.$$)}
LOCK=${LOCK:-~/.$PGM.lock}

# composer -v is slow, query from main script if needed
# COMPOSER_HOME=${COMPOSER_HOME:-$(command -v composer >/dev/null && composer config home -q || true)}
OS=$(uname -s)
OS_RELEASE=$(uname -r)

trap 'rm -f $TMP.* $LOCK' EXIT

BASE_DIR="${BASE_DIR:-$(cd $(dirname $0)/.. && pwd || true)}"
BIN_DIR="$(cd "${BASE_DIR}"/bin 2>/dev/null && pwd || true)"
DEV_DIR="$(cd "${BASE_DIR}"/dev 2>/dev/null && pwd || true)"
TESTS_DIR="$(cd "${BASE_DIR}"/tests 2>/dev/null && pwd || true)"
VENDOR_BIN="$(cd "${BASE_DIR}"/vendor/bin 2>/dev/null && pwd || true)"

# === Script tools ===

# Debug checking function
debug_mode() {
	is_true "${DEBUG:-}"
}

debug() {
	debug_mode && log "$*" || true
}

success() {
	log 0 "$@"
}

warning() {
	local err=$(echo "$1" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift
	log $err "${YELLOW}[WARNING]${STD}" "$@"
}

error() {
	local err=$(echo "$1" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift
	[ ${err:-0} -ne 0 ] || err=1
	log ${err:-1} "$*"
	return ${err:-1}
}

end() {
	local caller_file="${BASH_SOURCE[1]}"
	local caller_line="${BASH_LINENO[0]}"
	# err=$(echo "$1" | grep -E "^[1-9][0-9]*$" || true)
	local err=$(echo "${1:-}" | grep -E "^[0-9]+$" && shift || false)
	[ -z "$err" ] || shift
	if [ "$err" -a "$err" != "0" ]; then
		prefix="[ERROR]"
		debug_mode && suffix="$caller_file:$caller_line" || suffix=
	else
		prefix=
		suffix=
	fi

	[ "${1:-}" = "-n" ] && n="-n" && shift || n=
	local message=${@:-$(debug_mode && echo Finished processing)} || true
	log $err $prefix "$message"
	[ -n "$suffix" ] && echo "  trace: $suffix"
	exit ${err:-0}
}

die() {
	local err=$(echo "${1:-}" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift
	[ ${err:-0} -ne 0 ] || err=1
	end $err "$@"
}

read_env() {
	# Preserve APP_ENV if already set
	SAFE_ENV="${APP_ENV:-}"
	env_files=(
		"${BASE_DIR}/.env${APP_ENV:+.${APP_ENV}}"
	)
	[ -n "${ENV_SLUG:-}" ] && env_files+=("${BASE_DIR}/${ENV_SLUG}/.env")
	ENV_FILE=${ENV_FILE:-${env_files[-1]}}
	for file in ${env_files[@]}; do
		[ -f "$file" ] && ENV_FILE="$file" || continue
		debug source env $file
		(
			[ -n "${APP_ENV:-}" ] &&
				grep -v "^APP_ENV=" $file ||
				cat $file
		) >$TMP.env
		source $TMP.env
	done
	[ -n "${SAFE_ENV}" ] && APP_ENV="${SAFE_ENV}"
}

update_env() {
	local key=$1
	shift
	value="$@"
	[ -f "$ENV_FILE" ] || touch $ENV_FILE
	if egrep -q "^[# ]*${key}=($value|\"$value\"|'$value')" $ENV_FILE; then
		debug "  no change for ${key}, skipping"
		return
	elif egrep -q "^[# ]*${key}=" $ENV_FILE; then
		sed -i~ "s+^[# ]*${key}=.*+${key}=${value}+" $ENV_FILE &&
			debug "  updated ${key} in $ENV_FILE" &&
			return ||
			error "  could update $key in $ENV_FILE"
	else
		echo "${key}=${value}" >>$ENV_FILE &&
			debug "  added ${key} to $ENV_FILE" &&
			return ||
			error "  could not add $key to $ENV_FILE"
	fi
	return $?
}

update_env_keys() {
	local errors=0
	[ -f "$ENV_FILE" ] || touch $ENV_FILE
	for key in "$@"; do
		local value="${!key:-}"
		[ -z "$value" ] && continue
		update_env "$key" "${value}" && continue
		error "could not store $key in $ENV_FILE"
		errors=$((errors + 1))
	done
	return $errors
}

ucfirst() {
	[ -z "$*" ] && return
	word="$1"
	shift
	output=
	output+="$(tr '[:lower:]' '[:upper:]' <<<${word:0:1})"
	echo "${word:1}" | grep -q "[a-z]" &&
		output+="${word:1}" ||
		output+="$(tr '[:upper:]' '[:lower:]' <<<${word:1})"

	echo "$output $@" | sed "s/ *$//"
}

upper_case() {
	echo "$@" | tr '[:lower:]' '[:upper:]'
}

lower_case() {
	echo "$@" | tr '[:upper:]' '[:lower:]'
}

title_case() {
	[ -z "$*" ] && return
	echo "$@" | while read line; do
		output=
		for word in $(words "$line"); do
			output="${output:+ $output}$(ucfirst "${word}") "
		done
		echo ${output:-}
	done
}

words() {
	echo "$@" | sed -E "s/[^a-z0-9]+/ /gi; s/([a-z])([A-Z])/\1 \2/g; s/^[^a-z0-9]+//gi; s/[^a-z0-9]+$//gi;"
}

transliterate() {
	[ -z "$*" ] && return
	# ! command iconv && echo "$@" | tr ", áàâäéèêëíìîïóòôöúùûüçñ" "__aaaaeeeeiiiioooouuuucn" && return
	string=$(iconv -c -f utf8 -t ascii//TRANSLIT <<<"${@}") || return $?
	string=$(echo "$string" | sed "s/[^[:alnum:] _-]//g")
	echo "$string"
}

camel_case() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		output=
		for word in $(words "$line"); do
			[ -z "$output" ] &&
				output="$(lower_case "$word")" ||
				output+="$(ucfirst "${word}")"
		done
		echo ${output:-}
	done
}

pascal_case() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		title_case "$line" | sed "s/ //g"
	done
}

snake_case() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		words "${line}" | tr "[:upper:] " "[:lower:]_"
	done
}

kebab_case() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		words "${line}" | tr "[:upper:] " "[:lower:]-"
	done
}

screaming_snake_case() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		words "${line}" | tr "[:lower:] " "[:upper:]_"
	done
}

constant_case() {
	screaming_snake_case "$@"
}

dot_var() {
	[ -z "$*" ] && return
	transliterate "$@" | while read line; do
		words "${line}" | tr " " "."
	done
}

urlencode() {
	if command -v jq >/dev/null; then
		jq -rn --arg x "$string" '$x|@uri'
	else
		debug "jq not installed, fallback to degraded urlencode method"
		printf '%s' "$@" | while IFS='' read -n 1 c; do [[ "$c" =~ [A-Za-z0-9.~_-] ]] && printf "$c" || printf '%%%02X' "'$c"; done
		return 1
	fi
}

urldecode() {
	: "${*//+/ }"
	echo -e "${_//%/\\x}"
}

get_config() {
	[ -z "${ENV_PATTERN:-}" ] && log 1 "$(system_message error_env_pattern_missing)" && return 1
	set | egrep "${ENV_PATTERN:-}" || log 1 "$(system_message error_empty_config)"
}

set_help_messages() {
	SYNTAX="${SYNTAX:-$(echo $(
		echo $OPTS | sed "s/-://g" | sed "s/\(.*\)/[-\\1] [<args>]/g" | sed "s/\(.\):/] [-\\1 <value>/g"
		echo $LONGOPTS | sed "s/,/] [--/g; s/^/[--/; s/$/]/"
	))}"

	USAGE=${USAGE:-$PGM $SYNTAX}
}

usage() {
	if [ ! "$USAGE" ]; then
		PAR=$(echo $OPTS | sed 's/.://g' | grep -v "^$" | sed "s/\([a-zA-Z0-9]*\)/[-\1]/g")
		PAROPT=$(echo $OPTS | sed "s/-://" | sed 's/\(.\)/\1\//g' |
			sed 's/\(.\)\/:\//[-\1 <value>] /g' |
			sed "s/.\///g")
		USAGE=$(echo $PGM $PAR $PAROPT "[...]" | sed "s/  / /g")
	fi
	echo "usage: $USAGE"
}

help() {
	usage
	[ -n "${HELP:-}" ] && echo "$HELP"
}

bcr() { # bc rounded
	[ "${1:-}" ] || return 1
	local scale=${2:-2}

	bc -l <<<"scale=$scale+1;t=$1;scale-=1;(t*10^scale+((t>0)-(t<0))/2)/10^scale"
}

minutes_to_str() {
	local total_minutes hours minutes
	[ "${1:-}" ] || return 1
	total_minutes=$(bcr $1 0)
	hours=$(($total_minutes / 60))
	minutes=$((total_minutes % 60))
	[ $hours -gt 0 ] &&
		printf "%02dh%02d\n" $hours $minutes ||
		printf "%02d'\n" $minutes
}

seconds_to_str() {
	local d h m s
	d=$(($1 / 86400))
	[ $d = 1 ] && days="$d day "
	[ $d -gt 1 ] && days="$d days "
	h=$(($1 % 86400 / 3600))
	m=$(($1 % 3600 / 60))
	s=$(($1 % 60))
	printf "%s%02d:%02d:%02d\n" "${days:-}" $h $m $s |
		sed "s/^00://g;
        s/^00:0*\([0-9][0-9]*\)/\\1 seconds/g;
        s/^[01] seconds/1 second/;
        s/ 00:00:00$//"
}

countdown() {
	[ "$1" ] && secs=$1 && shift || secs=5
	[ "$1" ] && msg=$@ || msg=Countdown
	while [ $secs -gt 0 ]; do
		time=$(seconds_to_str $secs)
		printf "\r\033[K$msg $time"
		secs=$(($secs - 1))
		read -t 1 && return
	done
	printf "\r\033[K"
}

ansi_color() {
	for p; do
		case $p in
		black) color=0 ;;
		red) color=1 ;;
		green) color=2 ;;
		yellow) color=3 ;;
		blue) color=4 ;;
		purple) color=5 ;;
		cyan) color=6 ;;
		white) color=7 ;;

		regular) style=0 ;;
		bold) style=1 ;;
		underline) style=4 ;;

		background) scope=4 ;;
		high) high=yes ;;
		*) ;;
		esac
	done
	style=${style:-0}
	color=${color:-0}
	scope=${scope:-3}

	if is_true ${high:-}; then
		[ $scope -eq 4 ] && scope=10 || scope=9
	fi

	# printf "\033[%d;%d%dm[%d;%d%d]" ${style:-0} ${scope:-3} ${color:-0} ${style:-0} ${scope:-3} ${color:-0}
	printf "\033[%d;%d%dm" ${style:-0} ${scope:-3} ${color:-0}
}

ansi_reset() {
	printf "\033[0m"
}

STDOUT=${STDOUT:-"&1"}
STDERR=${STDERR:-"&2"}
QUIET=${QUIET:-}

STD=$(ansi_reset)
BLACK=$(ansi_color bold black)
RED=$(ansi_color bold red)
GREEN=$(ansi_color bold green)
YELLOW=$(ansi_color bold yellow)
BLUE=$(ansi_color bold blue)
PURPLE=$(ansi_color bold purple)
CYAN=$(ansi_color bold cyan)
WHITE=$(ansi_color bold white)

BG_BLACK=$(ansi_color background black)
BG_RED=$(ansi_color background red)
BG_GREEN=$(ansi_color background green)
BG_YELLOW=$(ansi_color background yellow)
BG_BLUE=$(ansi_color background blue)
BG_PURPLE=$(ansi_color background purple)
BG_CYAN=$(ansi_color background cyan)
BG_WHITE=$(ansi_color background white)

COLOR_HIGHLIGHT="${BG_BLACK}"
COLOR_NORMAL="${STD}"

# === Read command line arguments ===

# Use gnu-getopt if installed
prepend_path /usr/local/opt/gnu-getopt/bin

# Original arguments, before any parsing
ARGV=("$@")

# Validate command-line args only if options are already defined by parent
if [ -n "${OPTS:-}${LONGOPTS:-}" ]; then
	OPTS="${OPTS:-hqv}"
	LONGOPTS="${LONGOPTS:+${LONGOPTS},}testing,dev,help,quiet,verbose"
	set_help_messages
	if getopt -V | grep -q util-linux; then
		parsed_opts=$(getopt -o "$OPTS" -l "$LONGOPTS" -n "${RED}$PGM${STD}" -- "$@") || exit $?
		eval set -- "$parsed_opts"
	else
		warning "GNU getopt is recommended for proper command-ling args handling." \
			$([ "$OS" = "Darwin" ] && echo "Install with ${BG_WHITE}brew install gnu-getopt${STD}")
	fi
else
	OPTS="${OPTS:-hqv}"
	LONGOPTS="${LONGOPTS:+${LONGOPTS},}testing,dev,help,quiet,verbose"
	set_help_messages
fi

# Free arguments go to ARGS. The first one goes to COMMAND instead if it is
# listed in COMMANDOPTS (comma-separated); the parent decides what to do when
# no command was given.
ARGS=()
COMMAND=
_free_arg_seen=
for o; do
	case $o in
	--testing | --tests | --test)
		APP_ENV=testing
		ENV_SLUG=tests
		;;
	--prod | --production)
		APP_ENV=production
		ENV_SLUG=
		;;
	--dev)
		APP_ENV=dev
		ENV_SLUG=dev
		;;
	-h | --help)
		debug "opt --help"
		help
		end
		;;
	-q | --quiet)
		debug "opt --quiet"
		STDOUT="/dev/null"
		QUIET=yes
		DEBUG=no
		;;
	--dry-run)
		DRY_RUN=yes
		DRY_RUN_CMD=${DRY_RUN_CMD:-log "[DRY_RUN]"}
		;;
	-v | --verbose | --debug)
		STDERR="&1"
		DEBUG=yes
		debug "opt --verbose"
		;;
	-*)
		ARGS+=("$o")
		;;
	*)
		if [ -z "$_free_arg_seen" ] && [[ ",${COMMANDOPTS:-}," == *",$o,"* ]]; then
			COMMAND=$o
		else
			ARGS+=("$o")
		fi
		_free_arg_seen=yes
		;;
	esac
done
unset _free_arg_seen
[ ${ERROR:-} ] && usage && echo && die "$ERROR"

# Back to the script, which parses its own from here. Positional parameters set
# in a sourced file are the caller's, which is what makes this work at all.
set -- ${ARGS[@]+"${ARGS[@]}"}

[ "$#" -eq 0 ] || debug "un processed args passed to the main script: $*"

APP_ENV=${APP_ENV:-}
ENV_SLUG=${ENV_SLUG:-}
DEBUG=${DEBUG:-}

debug "APP_ENV ${APP_ENV:-(default)}"
debug "ENV_SLUG ${ENV_SLUG:-(default)}"

read_env

[ -f "${ENV_FILE}" ] || debug "No .env, using defaults, copy $BASE_DIR/.env.example as ${ENV_FILE} and edit adjust to your needs"

prepend_path ${APP_ENV:+${BASE_DIR}/${ENV_SLUG}/bin} $BIN_DIR $VENDOR_BIN

# Set environment

LOG_PREFIX=${LOG_PREFIX:-$PGM}
DRY_RUN_CMD=${DRY_RUN_CMD:-}
is_true ${DRY_RUN:-} && DRY_RUN=$DRY_RUN_CMD || DRY_RUN=

ENDSUCCESS=${ENDSUCCESS:-}
ENDFAILED=${ENDFAILED:-"Failed"}

TTS_ENABLED=$(is_true ${TTS_ENABLED:-no} && echo yes || echo no)
# update_env_keys ADMIN_PASSWORD DB_PASSWORD MUM_PUSH_KEY

TTS_LANG=${LC_MESSAGES:-${LC_ALL:-${LANG:-en}}}
TTS_LANG=$(echo "$TTS_LANG" | sed -E "s/^([a-z]+).*/\\1/")

is_true "${TTS_ENABLED:-}" &&
	SAY=$(which tts || which say || echo echo) ||
	SAY=echo

clean_path
export PATH
